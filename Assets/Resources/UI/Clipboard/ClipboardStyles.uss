/* ===================================================================
   Office Flip Out – Clipboard UI Stylesheet
   Layout is authored at 1920×1080 (px). Use PanelSettings scale mode
   "Scale With Screen Size" and the same reference resolution so this
   scales consistently across displays (see Assets/UI Toolkit/PanelSettings.asset).
   =================================================================== */

/* ---- Root ---- */

.clipboard-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.dimmer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(5, 8, 13, 0.65);
    transition-property: opacity;
    transition-duration: 220ms;
}

.dimmer.anim-hidden {
    opacity: 0;
}

.hidden { display: none; }

/* ---- Board (1480 x 960, flex-centered by shell) ---- */

.board-shadow {
    position: absolute;
    left: 8px;
    top: 10px;
    right: -8px;
    bottom: -10px;
    background-color: rgba(0, 0, 0, 0.30);
    border-radius: 6px;
}

.board {
    width: 1480px;
    height: 920px;
    background-color: rgb(130, 92, 55);
    border-radius: 6px;
    flex-direction: column;
    overflow: visible;
    flex-shrink: 0;

    transition-property: translate, scale, opacity;
    transition-duration: 380ms;
    transition-timing-function: ease-out;
}

.board.anim-closed {
    translate: 0 1200px;
    scale: 0.92 0.92;
    opacity: 0;
}

.board-face {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    background-color: rgb(162, 118, 74);
    border-radius: 4px;
}

/* ---- Clipboard Clip (top center) ---- */

.clipboard-clip {
    position: absolute;
    left: 50%;
    top: -100px;
    width: 108px;
    height: 160px;
    translate: -50% 0;
    background-image: resource('UI/Clipboard/clipboard_clip');
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- Quit Corner Button ---- */

.quit-corner-btn {
    position: absolute;
    right: 10px;
    top: 10px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgb(180, 60, 50);
    color: rgb(255, 240, 235);
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: rgb(140, 40, 35);

    transition-property: scale;
    transition-duration: 80ms;
}

.quit-corner-btn:hover { scale: 1.12 1.12; }
.quit-corner-btn:active { scale: 0.92 0.92; }

/* ---- Paper (1274 x 890, inset 16/14 from board) ---- */

.paper {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 14px;
    bottom: 14px;
    background-color: rgb(248, 244, 235);
    overflow: hidden;
}

/* ---- Ruled Lines & Margin ---- */

.ruled-lines {
    position: absolute;
    left: 76px;
    right: 76px;
    top: 0;
    bottom: 0;
}

.ruled-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: rgba(180, 200, 220, 0.165);
}

.margin-line {
    position: absolute;
    left: 74px;
    width: 5px;
    top: 68px;
    bottom: 48px;
    background-color: rgba(210, 140, 140, 0.137);
}

/* ---- Decorations ---- */

.tape-strip {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
    background-image: resource('UI/Clipboard/tape_strip');
    opacity: 0.75;
}

.tape-top-left {
    left: 76px;
    top: 68px;
    width: 65px;
    height: 60px;
    translate: -50% -50%;
    rotate: -35deg;
}

.tape-bottom-right {
    right: 76px;
    bottom: 44px;
    width: 60px;
    height: 55px;
    translate: 50% 50%;
    rotate: 30deg;
}

.coffee-ring {
    position: absolute;
    right: 100px;
    bottom: 130px;
    width: 140px;
    height: 140px;
    rotate: 14deg;
    background-image: resource('UI/Clipboard/coffee_ring');
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.22;
}

.board-paper-clip {
    position: absolute;
    right: -26px;
    top: 110px;
    width: 105px;
    height: 42px;
    rotate: -15deg;
    background-image: resource('UI/Clipboard/paper_clip');
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- Paper Content (1238 x 874) ---- */

.paper-content {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 10px;
    bottom: 10px;
}

/* ---- Sticky Tabs (taller hit area for mouse @ 1080p) ---- */

.sticky-tabs {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 16px;
    height: 48px;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
}

.sticky-tab-root {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 8px;
    margin-right: 8px;
    border-radius: 4px;
    overflow: hidden;

    /* Scale overflows flex slots and draws on top of neighbors — use color only. */
    transition-property: background-color, opacity;
    transition-duration: 100ms;
}

.sticky-tab-root:hover { opacity: 0.92; }
.sticky-tab-root:active { opacity: 0.88; }
.sticky-tab-root.tab-active { opacity: 1; }

.tab-shadow {
    position: absolute;
    left: 1px;
    right: 1px;
    top: 3px;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.12);
    border-radius: 4px;
}

.sticky-tab-btn {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(40, 32, 22);
    -unity-font-style: bold;
    font-size: 20px;
    -unity-text-align: middle-center;
}

.tab-yellow { background-color: rgb(255, 242, 130); }
.tab-green  { background-color: rgb(170, 225, 170); }
.tab-blue   { background-color: rgb(160, 200, 240); }

.tab-yellow.tab-active { background-color: rgb(255, 255, 145); }
.tab-green.tab-active  { background-color: rgb(185, 240, 185); }
.tab-blue.tab-active   { background-color: rgb(175, 215, 255); }

/* ---- Header (compact vertical so cards get more room) ---- */

.header {
    position: absolute;
    left: 0;
    right: 0;
    top: 68px;
    height: 56px;
    justify-content: center;
    align-items: center;
}

.title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(38, 28, 18);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.subtitle {
    font-size: 17px;
    -unity-font-style: italic;
    color: rgb(88, 78, 64);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

/* ---- Rules (static 1px lines) ---- */

.top-rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 130px;
    height: 1px;
    background-color: rgba(180, 166, 146, 0.314);
}

.bottom-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 48px;
    height: 1px;
    background-color: rgba(180, 166, 146, 0.314);
}

/* ---- Content Area (between rules) ---- */

.content {
    position: absolute;
    left: 0;
    right: 0;
    top: 136px;
    bottom: 52px;
}

.panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
}

/* ---- Footer (comfortable mouse targets @ 1080p) ---- */

.footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 44px;
    flex-direction: row;
    align-items: stretch;
}

.footer-btn {
    min-height: 44px;
    height: 44px;
    background-color: rgb(152, 96, 50);
    color: rgb(252, 240, 222);
    -unity-font-style: bold;
    font-size: 17px;
    border-width: 0;
    border-radius: 5px;

    transition-property: scale;
    transition-duration: 80ms;
}

.footer-btn:hover { scale: 1.05 1.05; }
.footer-btn:active { scale: 0.95 0.95; }

.footer-btn-back {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 128px;
    margin-left: 2px;
    margin-right: 6px;
    background-color: rgb(112, 86, 56);
}

.footer-btn-nav   { flex-grow: 0.7; margin-left: 4px; margin-right: 4px; }

/* Stay right-sized on Progress/Map (no nav): avoid stretching across the bar. */
.footer-btn-close {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: auto;
    margin-right: 8px;
    min-width: 168px;
    max-width: 260px;
}

.footer-counter-wrap {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.page-counter {
    font-size: 18px;
    -unity-font-style: italic;
    color: rgb(58, 48, 38);
    -unity-text-align: middle-center;
}

/* ===================================================================
   DIRECTORY PANEL
   =================================================================== */

.directory-grid-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
}

.dossier-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgb(248, 244, 235);
    padding-top: 2px;
}

/* Board paper-clip + dossier chrome stacked as duplicate “silver clips” — hide while dossier open */
.dossier-detail-open .board-paper-clip {
    display: none;
}

.directory-title-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    flex-shrink: 0;
    margin-bottom: 6px;
    padding-left: 4px;
}

.directory-title {
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(38, 28, 18);
    margin-right: 10px;
}

.directory-note {
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(24, 36, 92);
    flex-grow: 1;
}

/* ---- Staff Grid & Cards ---- */

.staff-grid {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
}

.staff-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgb(252, 249, 240);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(38, 28, 18, 0.08);
    flex-direction: column;
    overflow: visible;
}

.card-shadow {
    position: absolute;
    left: 3px;
    right: -5px;
    top: 1px;
    bottom: -4px;
    background-color: rgba(0, 0, 0, 0.118);
    border-radius: 3px;
}

.card-color-strip {
    height: 8px;
    flex-shrink: 0;
    background-color: rgb(128, 70, 160);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

.card-inner {
    flex-grow: 1;
    padding: 10px 12px;
    padding-top: 6px;
    flex-direction: column;
}

.card-name-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.card-name {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(38, 28, 18);
    flex-grow: 1;
}

.card-difficulty {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(180, 155, 40);
    -unity-text-align: middle-right;
    min-width: 56px;
}

.card-role {
    font-size: 14px;
    -unity-font-style: italic;
    color: rgb(110, 95, 75);
    margin-bottom: 2px;
}

.card-portrait {
    flex-grow: 1;
    min-height: 104px;
    background-color: rgb(208, 202, 192);
    -unity-background-scale-mode: scale-to-fit;
    margin-top: 2px;
    margin-bottom: 4px;
    overflow: visible;
}

/* ---- Rage Face Badge (overlaid on portrait corner) ---- */

.rage-face-badge {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 56px;
    height: 56px;
    background-color: rgba(248, 244, 235, 0.92);
    border-width: 1px;
    border-color: rgba(82, 66, 48, 0.35);
    border-radius: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- Status Badge ---- */

.status-badge {
    min-height: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 3px;
    justify-content: center;
    align-items: center;
    margin-bottom: 4px;
}

.status-active  { background-color: rgb(68, 135, 72); }
.status-flipped { background-color: rgb(178, 52, 38); }

.status-text {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

/* ---- Card Details ---- */

.card-separator {
    height: 1px;
    background-color: rgba(180, 166, 146, 0.314);
    margin-top: 3px;
    margin-bottom: 3px;
}

.card-dislikes {
    font-size: 15px;
    color: rgb(68, 54, 40);
    white-space: normal;
    margin-bottom: 3px;
}

.card-location {
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(30, 40, 90);
}

/* ---- Lock Badge ---- */

.lock-badge {
    background-color: rgba(155, 55, 40, 0.941);
    min-height: 24px;
    border-radius: 2px;
    justify-content: center;
    align-items: center;
    padding: 2px 6px;
    margin-top: 3px;
}

.lock-text {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 242, 235);
    -unity-text-align: middle-center;
}

/* ---- Card Button ---- */

.card-btn-wrap {
    padding: 6px 8px 8px;
    flex-shrink: 0;
}

.btn-open-profile {
    min-height: 42px;
    height: 42px;
    background-color: rgb(112, 86, 56);
    color: rgb(252, 244, 230);
    -unity-font-style: bold;
    font-size: 16px;
    border-width: 0;
    border-radius: 4px;

    transition-property: scale;
    transition-duration: 80ms;
}

.btn-open-profile:hover { scale: 1.05 1.05; }
.btn-open-profile:active { scale: 0.95 0.95; }
.btn-open-profile:disabled { opacity: 0.5; }

/* ---- Push Pins ---- */

.push-pin {
    position: absolute;
    top: -8px;
    width: 28px;
    height: 28px;
    background-image: resource('UI/Clipboard/push_pin');
    -unity-background-scale-mode: scale-to-fit;
}

/* One pin per staff card (scaled with slightly taller color strip) */
.push-pin-card {
    left: 50%;
    top: -4px;
    width: 22px;
    height: 22px;
    translate: -50% 0;
    rotate: -4deg;
}

/* ===================================================================
   DOSSIER (Detail drill-down inside Directory)
   =================================================================== */

/* Thin identity bar — full-width strip; runtime sets color (avoid heavy “second rule” look) */
.detail-color-banner {
    height: 4px;
    flex-shrink: 0;
    background-color: rgb(208, 202, 192);
}

.detail-folder-tab {
    position: absolute;
    right: 18px;
    top: -6px;
    width: 120px;
    height: 14px;
    opacity: 0.88;
    background-color: rgb(208, 202, 192);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

.detail-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 10px 16px 8px;
    flex-direction: column;
}

.detail-header-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.portrait-wrap {
    width: 136px;
    min-height: 176px;
    height: 176px;
    background-color: rgb(252, 249, 240);
    padding: 6px 6px 14px;
    margin-right: 18px;
    flex-shrink: 0;
    overflow: visible;
}

.portrait-shadow {
    position: absolute;
    left: 2px;
    right: -4px;
    top: 1px;
    bottom: -3px;
    background-color: rgba(0, 0, 0, 0.08);
}

.portrait {
    flex-grow: 1;
    background-color: rgb(208, 202, 192);
    -unity-background-scale-mode: scale-to-fit;
}

.portrait-tape {
    position: absolute;
    left: 50%;
    top: -5%;
    width: 50px;
    height: 46px;
    translate: -50% 0;
    rotate: -40deg;
    background-image: resource('UI/Clipboard/tape_strip');
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.75;
}

.identity-col {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

/* Name + difficulty on one row (matches staff cards) */
.detail-name-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 4px;
}

.detail-name {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(38, 28, 18);
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 10px;
    -unity-text-align: middle-left;
}

.detail-role {
    font-size: 15px;
    color: rgb(110, 95, 75);
    margin-bottom: 4px;
    white-space: normal;
}

.detail-difficulty {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(130, 108, 55);
    -unity-text-align: middle-right;
    flex-shrink: 0;
    min-width: 72px;
}

.detail-personality {
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(30, 40, 90);
    white-space: normal;
    margin-bottom: 6px;
}

.detail-status-row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    flex-shrink: 0;
    margin-top: 3px;
}

.detail-status-badge {
    min-width: 100px;
    min-height: 24px;
    height: 24px;
    border-radius: 2px;
    justify-content: center;
    align-items: center;
    padding: 0 6px;
}

.detail-lock-banner {
    background-color: rgba(155, 55, 40, 0.941);
    min-height: 30px;
    border-radius: 2px;
    justify-content: center;
    align-items: center;
    padding: 2px 8px;
    margin-top: 4px;
}

.detail-lock-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 242, 235);
    -unity-text-align: middle-center;
}

.dashed-line {
    height: 1px;
    flex-shrink: 0;
    background-color: rgba(180, 166, 146, 0.314);
    margin-top: 2px;
    margin-bottom: 2px;
}

.info-row {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 140px;
    margin-top: 6px;
}

.info-left-col {
    flex-grow: 1;
    flex-direction: column;
    margin-right: 22px;
    min-width: 0;
}

.info-right-col {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.info-section-header {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(110, 95, 75);
    margin-bottom: 4px;
}

.red-pen { color: rgba(200, 45, 35, 0.706); }

.info-body {
    font-size: 16px;
    color: rgb(68, 54, 40);
    white-space: normal;
    margin-bottom: 8px;
}

.info-schedule {
    font-size: 15px;
    white-space: normal;
}

/* Full width of likes/dislikes column */
.red-underline {
    align-self: stretch;
    width: 100%;
    height: 2px;
    background-color: rgba(200, 45, 35, 0.706);
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 6px;
}

.info-hint {
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(78, 62, 42);
    white-space: normal;
    margin-bottom: 8px;
}

.info-location {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(38, 28, 18);
    margin-bottom: 8px;
}

/* ===================================================================
   PROGRESS PANEL
   =================================================================== */

.progress-body {
    flex-grow: 1;
    padding: 16px 18px 14px;
    flex-direction: column;
}

.progress-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(38, 28, 18);
    margin-bottom: 6px;
    letter-spacing: 0.5px;
}

.progress-overall-row {
    margin-bottom: 14px;
}

.progress-overall-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(55, 44, 32);
    margin-bottom: 8px;
}

.progress-bar-track {
    height: 14px;
    background-color: rgb(220, 215, 205);
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.1);
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(68, 135, 72);
    border-radius: 7px;

    transition-property: width;
    transition-duration: 300ms;
}

.progress-npc-list {
    flex-grow: 1;
    min-height: 140px;
    margin-top: 0;
    margin-bottom: 10px;
    padding: 10px 12px;
    background-color: rgba(255, 255, 255, 0.42);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(38, 28, 18, 0.1);
}

.npc-progress-row {
    flex-direction: column;
    padding: 12px 10px;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.55);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(38, 28, 18, 0.06);
}

.npc-progress-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.npc-progress-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(38, 28, 18);
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 12px;
    -unity-text-align: middle-left;
}

/* Rage meter + mood badge read as one control (right side). */
.npc-mood-group {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
}

.npc-progress-status {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(68, 135, 72);
    border-radius: 3px;
    padding: 5px 11px;
    margin-left: 10px;
    -unity-text-align: middle-center;
}

.npc-progress-status.npc-flipped { background-color: rgb(178, 52, 38); }
.npc-progress-status.npc-locked  { background-color: rgb(80, 75, 70); }

.npc-task-row {
    flex-direction: column;
    align-items: stretch;
    margin-left: 0;
    padding-top: 2px;
}

.task-item {
    flex-direction: row;
    align-items: flex-start;
    margin-right: 0;
    margin-bottom: 5px;
    padding-left: 2px;
}

.task-check {
    font-size: 14px;
    -unity-font-style: bold;
    width: 22px;
    min-width: 22px;
    -unity-text-align: middle-left;
    margin-top: 1px;
}

.task-done    { color: rgb(48, 120, 58); }
.task-pending { color: rgb(105, 92, 78); }

.task-label {
    font-size: 15px;
    color: rgb(42, 36, 30);
    white-space: normal;
}

.task-label-done {
    color: rgb(118, 108, 96);
    -unity-font-style: italic;
}

.npc-rage-bar-track {
    height: 11px;
    width: 160px;
    min-width: 120px;
    flex-grow: 0;
    background-color: rgb(205, 198, 188);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(38, 28, 18, 0.14);
    overflow: hidden;
}

.npc-rage-bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 5px;
    background-color: rgb(215, 175, 55);

    transition-property: width;
    transition-duration: 300ms;
}

.npc-rage-bar-fill.rage-high { background-color: rgb(195, 55, 40); }

.progress-objective-section {
    margin-top: 8px;
    margin-bottom: 6px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(38, 28, 18, 0.1);
}

.progress-objective {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(50, 85, 55);
    white-space: normal;
    margin-top: 0;
    margin-bottom: 4px;
}

.progress-next-action {
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(72, 58, 40);
    white-space: normal;
}

.progress-security-row {
    margin-top: 6px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(38, 28, 18, 0.08);
}

.progress-security-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(120, 74, 44);
    margin-bottom: 4px;
}

.security-track { height: 12px; }
.security-fill  { background-color: rgb(200, 130, 45); }

/* ===================================================================
   MAP PANEL
   =================================================================== */

.map-body {
    flex-grow: 1;
    padding: 14px 18px;
    flex-direction: column;
}

.map-section-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(38, 28, 18);
    margin-bottom: 10px;
}

.map-placeholder-msg {
    font-size: 17px;
    -unity-font-style: italic;
    color: rgb(55, 44, 32);
    white-space: normal;
    margin-bottom: 18px;
}

.post-it-note {
    width: 240px;
    min-height: 88px;
    align-self: flex-start;
    background-color: rgb(255, 245, 155);
    padding: 12px;
    rotate: -2.2deg;
    overflow: visible;
    border-width: 1px;
    border-color: rgba(38, 28, 18, 0.12);
    border-radius: 2px;
}

.post-it-shadow {
    position: absolute;
    left: 2px;
    right: -4px;
    top: 1px;
    bottom: -3px;
    background-color: rgba(0, 0, 0, 0.08);
}

.post-it-pin {
    position: absolute;
    left: 50%;
    top: -8px;
    width: 28px;
    height: 28px;
    translate: -50% 0;
    rotate: 8deg;
    background-image: resource('UI/Clipboard/push_pin');
    -unity-background-scale-mode: scale-to-fit;
}

.post-it-text {
    font-size: 16px;
    color: rgb(48, 40, 30);
    white-space: normal;
}

/* ===================================================================
   QUIT POPUP
   =================================================================== */

.quit-popup {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(5, 8, 13, 0.45);
}

.quit-popup-card {
    min-width: 360px;
    max-width: 420px;
    background-color: rgb(248, 244, 235);
    border-radius: 8px;
    border-width: 3px;
    border-color: rgb(130, 92, 55);
    padding: 22px 24px;
    flex-direction: column;
    align-items: center;
}

.quit-popup-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(38, 28, 18);
    margin-bottom: 10px;
}

.quit-popup-msg {
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(55, 44, 32);
    margin-bottom: 18px;
    -unity-text-align: upper-center;
}

.quit-popup-actions {
    flex-direction: row;
    width: 100%;
}

.btn-pause {
    flex-grow: 1;
    min-height: 44px;
    height: 44px;
    -unity-font-style: bold;
    font-size: 16px;
    border-width: 0;
    border-radius: 3px;
    margin-left: 6px;
    margin-right: 6px;

    transition-property: scale;
    transition-duration: 80ms;
}

.btn-pause:hover { scale: 1.05 1.05; }
.btn-pause:active { scale: 0.95 0.95; }

.btn-resume {
    background-color: rgb(255, 242, 130);
    color: rgb(40, 32, 22);
}

.btn-quit {
    background-color: rgb(250, 180, 180);
    color: rgb(120, 35, 30);
}

/* ===================================================================
   Input polish — keyboard / controller navigation (UI Toolkit)
   =================================================================== */

/* Keep focus state visually neutral to avoid persistent click outlines. */
Button:focus {
    border-width: 0;
}

ScrollView:focus {
    border-width: 0;
}

/* ===================================================================
   Toolkit root (wraps main menu + clipboard shells)
   =================================================================== */

.toolkit-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Subtle gameplay affordance: bottom-left key hint for opening clipboard. */
.clipboard-hint {
    position: absolute;
    left: 22px;
    bottom: 18px;
    width: 88px;
    height: 122px;
    padding: 8px 6px 10px;
    border-radius: 8px;
    background-color: rgba(248, 244, 235, 0.9);
    border-width: 1px;
    border-color: rgba(90, 72, 52, 0.38);
    justify-content: flex-end;
    align-items: center;
    -unity-text-outline-width: 0;

    opacity: 0;
    translate: 0 10px;
    pointer-events: none;

    transition-property: opacity, translate;
    transition-duration: 220ms, 220ms;
    transition-timing-function: ease-out, ease-out;
}

.clipboard-hint.clipboard-hint--visible {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
}

.clipboard-hint-icon {
    width: 56px;
    height: 74px;
    margin-top: 4px;
    margin-bottom: 6px;
    background-image: resource('UI/Clipboard/clipboard_clip');
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.95;
}

.clipboard-hint-key {
    min-width: 56px;
    min-height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(90, 72, 52, 0.35);
    background-color: rgba(255, 252, 246, 0.92);
    color: rgb(48, 38, 28);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ===================================================================
   Main menu (same board/paper system as clipboard)
   =================================================================== */

.main-menu-paper-content {
    overflow: visible;
}

.main-menu-header {
    top: 10px;
    height: 268px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
}

.main-menu-title-image {
    position: absolute;
    left: 48px;
    right: 48px;
    top: 42px;
    height: 200px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.main-menu-header .subtitle {
    position: absolute;
    left: 48px;
    right: 48px;
    bottom: 6px;
}

.main-menu-title-fallback {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 56px;
    font-size: 36px;
}

.main-menu-title-fallback.hidden-title-fallback {
    display: none;
}

.main-menu-top-rule {
    top: 288px;
}

.main-menu-bottom-rule {
    bottom: 48px;
}

.main-menu-body.content {
    top: 300px;
    bottom: 52px;
    padding: 16px 28px 8px 28px;
    justify-content: flex-start;
    align-items: center;
}

.main-menu-tagline {
    font-size: 17px;
    -unity-font-style: italic;
    color: rgb(88, 78, 64);
    -unity-text-align: middle-center;
    white-space: normal;
}

.main-menu-helper {
    margin-top: 12px;
    font-size: 14px;
    color: rgb(105, 92, 75);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.main-menu-footer {
    justify-content: center;
    align-items: stretch;
}

.main-menu-footer .footer-btn {
    flex-grow: 0;
    min-width: 180px;
    max-width: 320px;
    margin-left: 10px;
    margin-right: 10px;
}

.main-menu-start-btn {
    min-width: 250px;
    font-size: 19px;
    background-color: rgb(170, 225, 170);
    color: rgb(34, 58, 36);
}

.main-menu-start-btn:hover {
    scale: 1.08 1.08;
}

.main-menu-quit-btn {
    background-color: rgb(130, 116, 98);
    color: rgb(240, 228, 210);
}
