<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/Clipboard/ClipboardStyles.uss?fileID=7433441132597879392&amp;guid=c056e806b68a040918cebe01ed3fcf17&amp;type=3#ClipboardStyles"/>
    <ui:VisualElement name="ToolkitRoot" class="toolkit-root">
    <ui:VisualElement name="MainMenuShell" class="clipboard-shell">
        <ui:VisualElement name="MainMenuDimmer" class="dimmer"/>
        <ui:VisualElement name="MainMenuBoard" class="board">
            <ui:VisualElement class="board-shadow"/>
            <ui:VisualElement class="board-face">
                <ui:VisualElement class="clipboard-clip"/>
                <ui:VisualElement name="MainMenuPaper" class="paper">
                    <ui:VisualElement name="MainMenuRuledLines" class="ruled-lines"/>
                    <ui:VisualElement class="margin-line"/>
                    <ui:VisualElement class="tape-strip tape-top-left"/>
                    <ui:VisualElement class="tape-strip tape-bottom-right"/>
                    <ui:VisualElement class="coffee-ring"/>
                    <ui:VisualElement class="board-paper-clip"/>
                    <ui:VisualElement class="paper-content main-menu-paper-content">
                        <ui:VisualElement class="header main-menu-header">
                            <ui:VisualElement name="MainMenuTitleImage" class="main-menu-title-image"/>
                            <ui:Label name="MainMenuTitleFallback" class="title main-menu-title-fallback" text="OFFICE FLIP OUT"/>
                            <ui:Label name="MainMenuSubtitle" class="subtitle" text="Confidential Clipboard. Cause chaos. Flip out the office."/>
                        </ui:VisualElement>
                        <ui:VisualElement class="top-rule main-menu-top-rule"/>
                        <ui:VisualElement class="bottom-rule main-menu-bottom-rule"/>
                        <ui:VisualElement class="content main-menu-body">
                            <ui:Label class="main-menu-tagline" text="HR-approved stress relief simulator."/>
                            <ui:Label class="main-menu-helper" text="Press Enter to Start"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="footer main-menu-footer">
                            <ui:Button name="MainMenuStart" class="footer-btn footer-btn-nav main-menu-start-btn" text="Start Game"/>
                            <ui:Button name="MainMenuQuit" class="footer-btn footer-btn-nav main-menu-quit-btn" text="Quit Game"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="ClipboardShell" class="clipboard-shell">
        <ui:VisualElement name="Dimmer" class="dimmer"/>
        <ui:VisualElement name="Board" class="board">
            <ui:VisualElement class="board-shadow"/>
            <ui:VisualElement class="board-face">
                <ui:VisualElement class="clipboard-clip"/>
                <ui:Button name="QuitCornerBtn" class="quit-corner-btn" text="×"/>
                <ui:VisualElement name="ClipboardPaper" class="paper">
                    <ui:VisualElement name="RuledLines" class="ruled-lines"/>
                    <ui:VisualElement class="margin-line"/>
                    <ui:VisualElement class="tape-strip tape-top-left"/>
                    <ui:VisualElement class="tape-strip tape-bottom-right"/>
                    <ui:VisualElement class="coffee-ring"/>
                    <ui:VisualElement class="board-paper-clip"/>
                    <ui:VisualElement class="paper-content">
                        <ui:VisualElement class="sticky-tabs">
                            <ui:VisualElement name="TabDirectoryRoot" class="sticky-tab-root tab-yellow">
                                <ui:VisualElement class="tab-shadow"/>
                                <ui:Button name="TabDirectory" class="sticky-tab-btn" text="Directory"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="TabProgressRoot" class="sticky-tab-root tab-green">
                                <ui:VisualElement class="tab-shadow"/>
                                <ui:Button name="TabProgress" class="sticky-tab-btn" text="Progress"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="TabMapRoot" class="sticky-tab-root tab-blue">
                                <ui:VisualElement class="tab-shadow"/>
                                <ui:Button name="TabMap" class="sticky-tab-btn" text="Map"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="header">
                            <ui:Label class="title" text="OFFICE FLIP OUT"/>
                            <ui:Label class="subtitle" text="Confidential Clipboard"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="top-rule"/>
                        <ui:VisualElement class="bottom-rule"/>
                        <ui:VisualElement class="content">
                            <ui:VisualElement name="DirectoryPanel" class="panel">
                                <ui:VisualElement name="DirectoryGridView" class="directory-grid-view">
                                    <ui:VisualElement class="directory-title-row">
                                        <ui:Label class="directory-title" text="Staff Directory"/>
                                        <ui:Label class="directory-note" text="Select a coworker to open their dossier."/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="staff-grid">
                                        <ui:VisualElement name="Card0" class="staff-card">
                                            <ui:VisualElement class="card-shadow"/>
                                            <ui:VisualElement name="Card0ColorStrip" class="card-color-strip"/>
                                            <ui:VisualElement class="card-inner">
                                                <ui:VisualElement class="card-name-row">
                                                    <ui:Label name="Card0Name" class="card-name" text="—"/>
                                                    <ui:Label name="Card0Difficulty" class="card-difficulty" text=""/>
                                                </ui:VisualElement>
                                                <ui:Label name="Card0Role" class="card-role" text=""/>
                                                <ui:VisualElement name="Card0Portrait" class="card-portrait">
                                                    <ui:VisualElement name="Card0RageFace" class="rage-face-badge"/>
                                                </ui:VisualElement>
                                                <ui:VisualElement name="Card0StatusBadge" class="status-badge status-active">
                                                    <ui:Label name="Card0StatusText" class="status-text" text="ACTIVE"/>
                                                </ui:VisualElement>
                                                <ui:VisualElement class="card-separator"/>
                                                <ui:Label name="Card0Dislikes" class="card-dislikes" text=""/>
                                                <ui:Label name="Card0Location" class="card-location" text=""/>
                                                <ui:VisualElement name="Card0LockBadge" class="lock-badge hidden">
                                                    <ui:Label name="Card0LockText" class="lock-text" text="LOCKED"/>
                                                </ui:VisualElement>
                                                <ui:VisualElement class="card-btn-wrap">
                                                    <ui:Button name="OpenProfile0" class="btn-open-profile" text="Open Dossier"/>
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:VisualElement class="push-pin push-pin-card"/>
                                        </ui:VisualElement>
                                        <ui:VisualElement name="Card1" class="staff-card">
                                            <ui:VisualElement class="card-shadow"/>
                                            <ui:VisualElement name="Card1ColorStrip" class="card-color-strip"/>
                                            <ui:VisualElement class="card-inner">
                                                <ui:VisualElement class="card-name-row">
                                                    <ui:Label name="Card1Name" class="card-name" text="—"/>
                                                    <ui:Label name="Card1Difficulty" class="card-difficulty" text=""/>
                                                </ui:VisualElement>
                                                <ui:Label name="Card1Role" class="card-role" text=""/>
                                                <ui:VisualElement name="Card1Portrait" class="card-portrait">
                                                    <ui:VisualElement name="Card1RageFace" class="rage-face-badge"/>
                                                </ui:VisualElement>
                                                <ui:VisualElement name="Card1StatusBadge" class="status-badge status-active">
                                                    <ui:Label name="Card1StatusText" class="status-text" text="ACTIVE"/>
                                                </ui:VisualElement>
                                                <ui:VisualElement class="card-separator"/>
                                                <ui:Label name="Card1Dislikes" class="card-dislikes" text=""/>
                                                <ui:Label name="Card1Location" class="card-location" text=""/>
                                                <ui:VisualElement name="Card1LockBadge" class="lock-badge hidden">
                                                    <ui:Label name="Card1LockText" class="lock-text" text="LOCKED"/>
                                                </ui:VisualElement>
                                                <ui:VisualElement class="card-btn-wrap">
                                                    <ui:Button name="OpenProfile1" class="btn-open-profile" text="Open Dossier"/>
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:VisualElement class="push-pin push-pin-card"/>
                                        </ui:VisualElement>
                                        <ui:VisualElement name="Card2" class="staff-card">
                                            <ui:VisualElement class="card-shadow"/>
                                            <ui:VisualElement name="Card2ColorStrip" class="card-color-strip"/>
                                            <ui:VisualElement class="card-inner">
                                                <ui:VisualElement class="card-name-row">
                                                    <ui:Label name="Card2Name" class="card-name" text="—"/>
                                                    <ui:Label name="Card2Difficulty" class="card-difficulty" text=""/>
                                                </ui:VisualElement>
                                                <ui:Label name="Card2Role" class="card-role" text=""/>
                                                <ui:VisualElement name="Card2Portrait" class="card-portrait">
                                                    <ui:VisualElement name="Card2RageFace" class="rage-face-badge"/>
                                                </ui:VisualElement>
                                                <ui:VisualElement name="Card2StatusBadge" class="status-badge status-active">
                                                    <ui:Label name="Card2StatusText" class="status-text" text="ACTIVE"/>
                                                </ui:VisualElement>
                                                <ui:VisualElement class="card-separator"/>
                                                <ui:Label name="Card2Dislikes" class="card-dislikes" text=""/>
                                                <ui:Label name="Card2Location" class="card-location" text=""/>
                                                <ui:VisualElement name="Card2LockBadge" class="lock-badge hidden">
                                                    <ui:Label name="Card2LockText" class="lock-text" text="LOCKED"/>
                                                </ui:VisualElement>
                                                <ui:VisualElement class="card-btn-wrap">
                                                    <ui:Button name="OpenProfile2" class="btn-open-profile" text="Open Dossier"/>
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:VisualElement class="push-pin push-pin-card"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="DossierView" class="dossier-view hidden">
                                    <ui:VisualElement name="DetailColorBanner" class="detail-color-banner"/>
                                    <ui:VisualElement name="DetailFolderTab" class="detail-folder-tab"/>
                                    <ui:VisualElement class="detail-body">
                                        <ui:VisualElement class="detail-header-row">
                                            <ui:VisualElement class="portrait-wrap">
                                                <ui:VisualElement class="portrait-shadow"/>
                                                <ui:VisualElement name="DetailPortrait" class="portrait"/>
                                                <ui:VisualElement class="portrait-tape"/>
                                            </ui:VisualElement>
                                            <ui:VisualElement class="identity-col">
                                                <ui:VisualElement class="detail-name-row">
                                                    <ui:Label name="DetailName" class="detail-name" text=""/>
                                                    <ui:Label name="DetailDifficulty" class="detail-difficulty" text=""/>
                                                </ui:VisualElement>
                                                <ui:Label name="DetailRole" class="detail-role" text=""/>
                                                <ui:Label name="DetailPersonality" class="detail-personality" text=""/>
                                                <ui:VisualElement name="DetailStatusRow" class="detail-status-row">
                                                    <ui:VisualElement name="DetailStatusBadge" class="detail-status-badge status-active">
                                                        <ui:Label name="DetailStatusText" class="status-text" text="ACTIVE"/>
                                                    </ui:VisualElement>
                                                </ui:VisualElement>
                                                <ui:VisualElement name="DetailLockBanner" class="detail-lock-banner hidden">
                                                    <ui:Label name="DetailLockText" class="detail-lock-text" text=""/>
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="dashed-line"/>
                                        <ui:VisualElement class="info-row">
                                            <ui:VisualElement class="info-left-col">
                                                <ui:Label name="DetailLikesHeader" class="info-section-header" text=""/>
                                                <ui:Label name="DetailLikes" class="info-body" text=""/>
                                                <ui:Label name="DetailDislikesHeader" class="info-section-header red-pen" text=""/>
                                                <ui:Label name="DetailDislikes" class="info-body" text=""/>
                                                <ui:VisualElement name="DetailDislikesUnderline" class="red-underline hidden"/>
                                            </ui:VisualElement>
                                            <ui:VisualElement class="info-right-col">
                                                <ui:Label name="DetailHint" class="info-hint" text=""/>
                                                <ui:Label name="DetailLocation" class="info-location" text=""/>
                                                <ui:Label name="DetailScheduleHeader" class="info-section-header" text=""/>
                                                <ui:Label name="DetailSchedule" class="info-schedule" text=""/>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="ProgressPanel" class="panel hidden">
                                <ui:VisualElement class="progress-body">
                                    <ui:Label class="progress-title" text="Mission Progress"/>
                                    <ui:Label name="ProgressOverallLabel" class="progress-overall-label" text="Coworkers Flipped: 0 / 0"/>
                                    <ui:VisualElement class="progress-overall-row">
                                        <ui:VisualElement class="progress-bar-track">
                                            <ui:VisualElement name="ProgressOverallFill" class="progress-bar-fill"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:ScrollView name="ProgressNpcList" class="progress-npc-list" mode="Vertical">
                                    </ui:ScrollView>
                                    <ui:VisualElement class="progress-objective-section">
                                        <ui:Label name="ProgressObjective" class="progress-objective" text=""/>
                                        <ui:Label name="ProgressNextAction" class="progress-next-action" text=""/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="progress-security-row">
                                        <ui:Label name="ProgressSecurityLabel" class="progress-security-label" text="Job Security: 0%"/>
                                        <ui:VisualElement class="progress-bar-track security-track">
                                            <ui:VisualElement name="ProgressSecurityFill" class="progress-bar-fill security-fill"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="MapPanel" class="panel hidden">
                                <ui:VisualElement class="map-body">
                                    <ui:Label class="map-section-title" text="Office Map"/>
                                    <ui:Label class="map-placeholder-msg" text="Floor map coming soon. For now, use the Directory tab to track coworkers."/>
                                    <ui:VisualElement class="post-it-note">
                                        <ui:VisualElement class="post-it-shadow"/>
                                        <ui:VisualElement class="post-it-pin"/>
                                        <ui:Label class="post-it-text" text="Remember: stress spreads. Plan your chaos."/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="FooterRow" class="footer">
                            <ui:Button name="FooterBackDossier" class="footer-btn footer-btn-back hidden" text="← Directory"/>
                            <ui:Button name="FooterPrevious" class="footer-btn footer-btn-nav" text=""/>
                            <ui:VisualElement name="FooterCounterWrap" class="footer-counter-wrap">
                                <ui:Label name="PageCounter" class="page-counter" text=""/>
                            </ui:VisualElement>
                            <ui:Button name="FooterNext" class="footer-btn footer-btn-nav" text=""/>
                            <ui:Button name="FooterClose" class="footer-btn footer-btn-close" text="Close Clipboard"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="QuitPopup" class="quit-popup hidden">
                    <ui:VisualElement class="quit-popup-card">
                        <ui:Label class="quit-popup-title" text="Paused"/>
                        <ui:Label class="quit-popup-msg" text="Take a breather — or leave the building."/>
                        <ui:VisualElement class="quit-popup-actions">
                            <ui:Button name="QuitPopupResume" class="btn-pause btn-resume" text="Resume"/>
                            <ui:Button name="QuitPopupQuit" class="btn-pause btn-quit" text="Quit Game"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="ClipboardHint" class="clipboard-hint">
        <ui:VisualElement class="clipboard-hint-icon"/>
        <ui:Label class="clipboard-hint-key" text="Tab"/>
    </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
