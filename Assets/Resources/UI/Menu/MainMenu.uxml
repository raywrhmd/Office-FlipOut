<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/Theme/Tokens.uss?fileID=7433441132597879392&amp;guid=b2e7f593c4f8d65fbb2d63c9f8e0a2e5&amp;type=3#Tokens"/>
    <Style src="project://database/Assets/Resources/UI/Theme/primitives.uss?fileID=7433441132597879392&amp;guid=f1e8c47aa9b045d2bbc94e1f6d28a703&amp;type=3#primitives"/>
    <Style src="project://database/Assets/Resources/UI/Clipboard/clipboard.base.uss?fileID=7433441132597879392&amp;guid=c3a5e1f7d2b94a4cb831e7f4a52b8d63&amp;type=3#clipboard.base"/>
    <Style src="project://database/Assets/Resources/UI/Clipboard/clipboard.components.uss?fileID=7433441132597879392&amp;guid=d4b6f208e3ca5b5dc942f805b63c9e74&amp;type=3#clipboard.components"/>
    <Style src="project://database/Assets/Resources/UI/Clipboard/clipboard.states.uss?fileID=7433441132597879392&amp;guid=e5c7038f04db6c6ed053f916c74da085&amp;type=3#clipboard.states"/>
    <ui:Template name="BoardChromeOverlay" src="project://database/Assets/Resources/UI/Theme/BoardChromeOverlay.uxml?fileID=9197481963319205126&amp;guid=8b41a92cf5d340f1a3b6e8c5f927ad11&amp;type=3#BoardChromeOverlay"/>

    <!--
      Main Menu lives in its own UIDocument so it stacks independently of the
      clipboard. Shares the paper/board chrome via the clipboard.* stylesheets.
    -->
    <!-- Root fills the screen via USS but must NOT steal picks when the shell
         is hidden — otherwise this document (high sortingOrder) blocks every
         panel below (clipboard, pause, HUD). -->
    <ui:VisualElement name="MainMenuRoot" class="toolkit-root" picking-mode="Ignore">
        <ui:VisualElement name="MainMenuShell" class="clipboard-shell" picking-mode="Position">
            <ui:VisualElement name="MainMenuDimmer" class="dimmer"/>
            <ui:VisualElement name="MainMenuBoard" class="board">
                <ui:VisualElement class="board-shadow"/>
                <ui:VisualElement class="board-face">
                    <ui:VisualElement class="clipboard-clip"/>
                    <ui:VisualElement name="MainMenuPaper" class="paper">
                        <ui:VisualElement name="MainMenuRuledLines" class="ruled-lines"/>
                        <ui:VisualElement class="margin-line"/>
                        <ui:Instance template="BoardChromeOverlay"/>
                        <ui:VisualElement class="paper-content main-menu-paper-content">
                            <ui:VisualElement class="header main-menu-header">
                                <ui:VisualElement name="MainMenuTitleImage" class="main-menu-title-image"/>
                                <ui:Label name="MainMenuTitleFallback" class="title main-menu-title-fallback" text="OFFICE FLIP OUT"/>
                                <ui:Label name="MainMenuSubtitle" class="subtitle" text="Confidential Clipboard. Cause chaos. Flip out the office."/>
                            </ui:VisualElement>
                            <ui:VisualElement class="top-rule main-menu-top-rule"/>
                            <ui:VisualElement class="bottom-rule main-menu-bottom-rule"/>
                            <ui:VisualElement class="content main-menu-body">
                                <ui:Label class="main-menu-tagline" text="HR-approved stress relief simulator."/>
                                <ui:Label class="main-menu-helper" text="Press Enter to Start"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="footer main-menu-footer">
                                <ui:Button name="MainMenuStart" class="btn btn--primary btn--lg footer-btn footer-btn-nav main-menu-start-btn" text="Start Game"/>
                                <ui:Button name="MainMenuQuit" class="btn btn--secondary btn--lg footer-btn footer-btn-nav main-menu-quit-btn" text="Quit Game"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
